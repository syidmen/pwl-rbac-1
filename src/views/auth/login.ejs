<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - RBAC System</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
  <div class="bg-white rounded-lg shadow-md p-8 w-full max-w-md">
    <h1 class="text-2xl font-bold text-center text-gray-800 mb-2">RBAC System</h1>
    <p class="text-center text-gray-500 text-sm mb-6">Role-Based Access Control Demo</p>

    <% if (error) { %>
    <div class="bg-red-50 text-red-700 border border-red-300 rounded p-3 mb-4 text-sm">
      <%= error %>
    </div>
    <% } %>

    <form method="POST" action="/auth/login" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Username</label>
        <input type="text" name="username" required
          class="w-full border border-gray-300 rounded px-3 py-2 text-sm
                 focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
        <input type="password" name="password" required
          class="w-full border border-gray-300 rounded px-3 py-2 text-sm
                 focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <button type="submit"
        class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700
               font-medium transition-colors">
        Login
      </button>
    </form>

    <div class="mt-6 p-4 bg-gray-50 rounded text-xs text-gray-600 space-y-1">
      <p class="font-semibold text-gray-700 mb-2">Demo Accounts:</p>
      <p><code class="bg-gray-200 px-1 rounded">admin / admin123</code> &mdash; semua akses</p>
      <p><code class="bg-gray-200 px-1 rounded">editor / editor123</code> &mdash; user & role (view only)</p>
      <p><code class="bg-gray-200 px-1 rounded">viewer / viewer123</code> &mdash; user view saja</p>
    </div>
  </div>
</body>
</html>
