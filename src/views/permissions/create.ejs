<div class="max-w-lg">
  <h2 class="text-lg font-semibold text-gray-700 mb-6">Tambah Permission Baru</h2>

  <div class="bg-blue-50 border border-blue-200 rounded p-4 mb-6 text-sm text-blue-700">
    <strong>Format nama:</strong> <code class="bg-blue-100 px-1 rounded">resource:action</code><br>
    Contoh: <code class="bg-blue-100 px-1 rounded">user:create</code>,
            <code class="bg-blue-100 px-1 rounded">role:delete</code>,
            <code class="bg-blue-100 px-1 rounded">report:view</code>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <form method="POST" action="/permissions" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Nama Permission</label>
        <input type="text" name="name" required placeholder="contoh: report:view"
          pattern="[a-z]+:[a-z]+"
          class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-mono
                 focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Resource</label>
        <input type="text" name="resource" required placeholder="contoh: reports"
          class="w-full border border-gray-300 rounded px-3 py-2 text-sm
                 focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Action</label>
        <select name="action" required
          class="w-full border border-gray-300 rounded px-3 py-2 text-sm
                 focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="">-- Pilih Action --</option>
          <option value="view">view</option>
          <option value="create">create</option>
          <option value="edit">edit</option>
          <option value="delete">delete</option>
          <option value="assign">assign</option>
        </select>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="submit"
          class="bg-blue-600 text-white px-6 py-2 rounded text-sm hover:bg-blue-700 transition-colors">
          Simpan
        </button>
        <a href="/permissions"
          class="bg-gray-100 text-gray-700 px-6 py-2 rounded text-sm hover:bg-gray-200 transition-colors">
          Batal
        </a>
      </div>
    </form>
  </div>
</div>
