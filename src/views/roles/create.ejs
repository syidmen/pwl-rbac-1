<div class="max-w-lg">
  <h2 class="text-lg font-semibold text-gray-700 mb-6">Tambah Role Baru</h2>

  <% if (error) { %>
  <div class="bg-red-50 text-red-700 border border-red-300 rounded p-3 mb-4 text-sm">
    <%= error %>
  </div>
  <% } %>

  <div class="bg-white rounded-lg shadow p-6">
    <form method="POST" action="/roles" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Nama Role</label>
        <input type="text" name="name" required placeholder="contoh: moderator"
          class="w-full border border-gray-300 rounded px-3 py-2 text-sm
                 focus:outline-none focus:ring-2 focus:ring-blue-500">
        <p class="text-xs text-gray-400 mt-1">Gunakan huruf kecil tanpa spasi</p>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="submit"
          class="bg-blue-600 text-white px-6 py-2 rounded text-sm hover:bg-blue-700 transition-colors">
          Simpan
        </button>
        <a href="/roles"
          class="bg-gray-100 text-gray-700 px-6 py-2 rounded text-sm hover:bg-gray-200 transition-colors">
          Batal
        </a>
      </div>
    </form>
  </div>
</div>
