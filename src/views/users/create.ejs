<div class="max-w-lg">
  <h2 class="text-lg font-semibold text-gray-700 mb-6">Tambah User Baru</h2>

  <% if (error) { %>
  <div class="bg-red-50 text-red-700 border border-red-300 rounded p-3 mb-4 text-sm">
    <%= error %>
  </div>
  <% } %>

  <div class="bg-white rounded-lg shadow p-6">
    <form method="POST" action="/users" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Username</label>
        <input type="text" name="username" required
          class="w-full border border-gray-300 rounded px-3 py-2 text-sm
                 focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
        <input type="password" name="password" required minlength="6"
          class="w-full border border-gray-300 rounded px-3 py-2 text-sm
                 focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
        <select name="role_id" required
          class="w-full border border-gray-300 rounded px-3 py-2 text-sm
                 focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="">-- Pilih Role --</option>
          <% roles.forEach(function(role) { %>
          <option value="<%= role.id %>"><%= role.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="submit"
          class="bg-blue-600 text-white px-6 py-2 rounded text-sm hover:bg-blue-700 transition-colors">
          Simpan
        </button>
        <a href="/users"
          class="bg-gray-100 text-gray-700 px-6 py-2 rounded text-sm hover:bg-gray-200 transition-colors">
          Batal
        </a>
      </div>
    </form>
  </div>
</div>
